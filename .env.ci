# Dummy, non-secret values so `next build` passes env validation in CI and in the Docker build stage.
# Only variables that have no other source belong here: sourcing this file overrides build args and job env.
# (NEXT_PUBLIC_SITE_URL, BRAND, BUILD_SHA come from the Docker build args / the CI job env.)
DATABASE_URL=postgres://ci:ci@localhost:5432/ci
PAYLOAD_SECRET=ci-dummy-secret-not-used-anywhere-0123456789
