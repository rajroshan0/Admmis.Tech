[Unit]
Description=ADMMIS lead worker tick
After=docker.service

[Service]
Type=oneshot
User=deploy
EnvironmentFile=/opt/admmis/.env.production
ExecStart=/bin/sh -c 'curl --fail --silent --show-error --max-time 50 -X POST -H "x-worker-secret: $WORKER_SECRET" http://127.0.0.1:3000/api/internal/lead-worker >/dev/null'
