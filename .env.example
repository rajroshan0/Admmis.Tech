# Names and safe placeholders only. Copy to .env and fill in. Never commit .env.
# Required
DATABASE_URL=postgres://admmis:admmis@localhost:5432/admmis_tech
PAYLOAD_SECRET=change-me-to-a-random-string-of-at-least-32-characters
BRAND=admmis-tech
ENABLED_LOCALES=en
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Build metadata (set by CI/Docker; defaults to "dev")
# BUILD_SHA=

# Media storage, Cloudflare R2 (leave empty in dev: media is stored on local disk)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Lead pipeline (docs/api/leads.md §11, names by neha). Providers default to "log"; empty is fine now
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
WORKER_SECRET=
LEAD_EMAIL_PROVIDER=log
RESEND_API_KEY=
BREVO_API_KEY=
LEAD_ALERT_TO=
LEAD_ALERT_FROM=
LEAD_CHAT_PROVIDER=log
SLACK_LEAD_WEBHOOK_URL=
LEAD_CHAT_INCLUDE_MESSAGE=false
LEAD_CRM_PROVIDER=log
HUBSPOT_ACCESS_TOKEN=
LEAD_ALLOWED_HOSTS=localhost:3000

# Monitoring and analytics (consent-gated, ADR-006)
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
